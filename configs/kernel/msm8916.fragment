# msm8916.fragment - config fragment for the custom 6.18 kernel.
# Applied on top of arch/arm64/configs/defconfig, then `make olddefconfig`.
# Values follow aipmy/msm8916-openwrt msm89xx/config-6.12 (OpenWrt delta
# config, 6.12.94) wherever defconfig differs; symbols defconfig already
# sets correctly are repeated here so the intent is explicit in one place.
# USB gadget FunctionFS (ADB) and the modem data path are the hard
# requirements; CGROUPS is needed by Docker, ZRAM/WIREGUARD by the images.
#
# Notes:
# - LEDS_QCOM_LPG stays =m after olddefconfig (it depends on PWM, which
#   defconfig leaves as a module). The module autoloads via DT modalias;
#   forcing PWM=y to get =y was not worth the extra defconfig churn.
# - Modules are left uncompressed (.ko, not .ko.zst): the pmOS kernel
#   ships zst modules, but enabling CONFIG_MODULE_COMPRESS_ZSTD would add
#   a host zstd dependency to the build. Revisit if rootfs size matters.

# --- cgroups / namespaces (defconfig leaves these to Kconfig defaults) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y

# --- platform / clock / pinctrl / regulators ---
CONFIG_MSM_GCC_8916=y
CONFIG_QCOM_CLK_APCS_MSM8916=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_A53PLL=y
CONFIG_PINCTRL_MSM8916=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_SPM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8916=y
CONFIG_INTERCONNECT_QCOM_SMD_RPM=y
CONFIG_INTERCONNECT_CLK=y

# --- remoteproc / rpmsg / QRTR (modem path) ---
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_MDT_LOADER=m
CONFIG_QCOM_PIL_INFO=m
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_RPMSG_WWAN_CTRL=m
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_RPM_MASTER_STATS=m

# --- modem data / wifi ---
CONFIG_QCOM_BAM_DMUX=m
CONFIG_QCOM_BAM_DMA=y
CONFIG_WCN36XX=m

# --- thermal / cpufreq ---
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_OF=y

# --- storage / usb ---
CONFIG_MMC_SDHCI_MSM=y
CONFIG_QCOM_IOMMU=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- soc / power / misc ---
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_WDT=y
CONFIG_QCOM_CPR=y
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- image features ---
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_WIREGUARD=m

# --- release string ---
# uname -r becomes 6.18.65-msm8916, so the custom kernel is distinguishable
# from the postmarketOS kernel it replaces.
CONFIG_LOCALVERSION="-msm8916"

# --- tunnel / proxy (mihomo / Clash.Meta and tunnel apps) ---
# =m everywhere except bools (which can only be =y). This replaces the
# six vermagic-locked prebuilt .ko aipmy shipped (gre, l2tp_core,
# l2tp_netlink, l2tp_ppp, ppp_mppe, pptp) with in-tree modules built
# against this exact kernel. Renames vs the request: FOU is NET_FOU in
# 6.18, IP_UDP_TUNNEL is NET_UDP_TUNNEL, and the xtables symbols carry
# the NETFILTER_XT_ prefix (XT_TARGET_TPROXY / XT_MATCH_* / XT_SET).
CONFIG_TUN=m
CONFIG_TAP=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_NET_IPGRE=m
CONFIG_IPV6_GRE=m
CONFIG_NET_IPIP=m
CONFIG_IPV6_SIT=m
CONFIG_IPV6_TUNNEL=m
CONFIG_L2TP=m
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=m
CONFIG_L2TP_ETH=m
CONFIG_PPP=m
CONFIG_PPPOE=m
CONFIG_PPTP=m
CONFIG_PPP_MPPE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_XFRM_USER=m
CONFIG_XFRM_INTERFACE=m
CONFIG_NET_KEY=m
CONFIG_INET_ESP=m
CONFIG_INET_IPCOMP=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_NET_FOU=m
CONFIG_NET_UDP_TUNNEL=m
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_TARGET_NETMAP=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NF_TPROXY_IPV6=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_IP_SET=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_CGROUP_NET_PRIO=y
CONFIG_VETH=m
CONFIG_BRIDGE=m

# --- tunnel/proxy prerequisites (dependencies of the symbols above) ---
# These are not in defconfig; without them olddefconfig silently drops
# the symbols that depend on them (see docs/kernel-6.18.md).
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
