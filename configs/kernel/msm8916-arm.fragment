# arm32 supplement to msm8916.fragment — ARCH=arm builds only.
#
# multi_v7_defconfig (the arm base config) leaves several subsystems
# off that arm64's defconfig presets, which silently drops fragment
# symbols that depend on them (olddefconfig removes symbols whose
# dependencies are unmet, without any error). Enabling the gates here
# makes the full msm8916.fragment land on arm exactly as on arm64 —
# verified locally: 158/158 fragment symbols, including the hard
# requirements QCOM_BAM_DMUX=m, NF_TABLES=m and NET_CLS_CGROUP=m.
#
#   NETFILTER / NETFILTER_XTABLES / IP_NF_IPTABLES
#       Gate the whole netfilter + legacy-iptables block of the
#       fragment (nftables targets, XT matches/targets, IP_NF_NAT,
#       IP_NF_MANGLE, ...). NET_SCHED gates NET_CLS_CGROUP.
#   WWAN
#       Gates drivers/net/wwan/Kconfig, which holds QCOM_BAM_DMUX
#       (modem data) and RPMSG_WWAN_CTRL.
#   PWM / LEDS_CLASS_MULTICOLOR
#       Gate LEDS_QCOM_LPG (drivers/leds/rgb/Kconfig is sourced only
#       under LEDS_CLASS_MULTICOLOR, and the driver depends on PWM).
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_NET_SCHED=y
CONFIG_WWAN=y
CONFIG_PWM=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
