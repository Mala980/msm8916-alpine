#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# modem-bandlock - persistent modem band lock CLI for the MSM8916
# dongles, adapted from aipmy/msm8916-openwrt (where band locking was
# a UCI value re-applied by an init script + iface hotplug hook).
#
# Here it is a plain CLI on top of ModemManager (mmcli):
#   modem-bandlock list          supported + current bands
#   modem-bandlock set <bands>   apply now and persist
#   modem-bandlock clear         back to all supported bands, unpersist
#   modem-bandlock apply         re-apply the persisted set (boot service)
#
# <bands> accepts mmcli band names ("eutran-3|eutran-7|eutran-20",
# commas also work) or bare LTE band numbers ("3,7,20").
# Persistence: BANDLOCK_BANDS in /etc/modem-bandlock.conf; the
# modem-bandlock boot service runs `modem-bandlock apply` after
# ModemManager is up.  Note ModemManager itself also remembers the
# current bands across reboots on many firmwares - the boot service
# exists so the CLI's choice is authoritative.

CONF=/etc/modem-bandlock.conf
TAG=modem-bandlock

log() { logger -t "$TAG" "$*" 2>/dev/null; echo "[$TAG] $*"; }

persisted_bands() {
	[ -f "$CONF" ] || return 0
	sed -n 's/^BANDLOCK_BANDS=//p' "$CONF" | tr -d '"' | head -n1
}

normalise() { # "3,7" or "eutran-3, eutran-7" -> "eutran-3|eutran-7"
	echo "$1" | tr ',' '|' | tr -s ' ' | sed 's/ //g' | \
		sed 's/\([0-9][0-9]*\)/eutran-\1/g; s/eutran-eutran-/eutran-/g'
}

supported_bands() {
	mmcli -m any --output-keyvalue 2>/dev/null | \
		awk -F': ' '/modem.generic.supported-bands.value/ {print $2}'
}

current_bands() {
	mmcli -m any --output-keyvalue 2>/dev/null | \
		awk -F': ' '/modem.generic.current-bands.value/ {print $2}'
}

wait_modem() { # up to ~30 s for a modem object
	i=0
	while [ "$i" -lt 30 ]; do
		mmcli -m any >/dev/null 2>&1 && return 0
		sleep 1; i=$((i + 1))
	done
	return 1
}

case "${1:-list}" in
	list)
		echo "Supported: $(supported_bands || echo '?')"
		echo "Current:   $(current_bands || echo '?')"
		echo "Persisted: $(persisted_bands || echo '(none - all bands)')"
		;;
	set)
		[ -n "${2:-}" ] || { echo "usage: modem-bandlock set <bands>  (e.g. 3,7,20 or eutran-3|eutran-7)" >&2; exit 2; }
		bands=$(normalise "$2")
		wait_modem || { echo "modem-bandlock: no modem from ModemManager" >&2; exit 1; }
		log "applying band lock: $bands"
		mmcli -m any --set-current-bands="$bands" || { echo "modem-bandlock: mmcli failed" >&2; exit 1; }
		{ echo "# Written by modem-bandlock; reapplied at boot by the modem-bandlock service."
		  echo "BANDLOCK_BANDS=\"$bands\""; } > "$CONF"
		echo "Band lock set and persisted in $CONF"
		;;
	clear)
		wait_modem || { echo "modem-bandlock: no modem from ModemManager" >&2; exit 1; }
		all=$(supported_bands | tr ',' '|' | tr -d ' ')
		[ -n "$all" ] && mmcli -m any --set-current-bands="$all" || true
		rm -f "$CONF"
		echo "Band lock cleared (all supported bands, persistence removed)"
		;;
	apply)
		bands=$(persisted_bands)
		[ -n "$bands" ] && [ "$bands" != "all" ] || exit 0
		wait_modem || exit 0
		log "re-applying persisted band lock: $bands"
		mmcli -m any --set-current-bands="$bands" >/dev/null 2>&1 || true
		;;
	-h|--help)
		sed -n '2,25p' "$0" | sed 's/^#\{0,1\} \{0,1\}//' ;;
	*) echo "usage: modem-bandlock {list|set <bands>|clear|apply}" >&2; exit 2 ;;
esac
