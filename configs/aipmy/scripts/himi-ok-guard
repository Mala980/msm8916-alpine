#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# himi-ok-guard - keep modem NV item 2500 == "HiMI_OK".
#
# Adapted from aipmy/msm8916-openwrt's base-files himi-ok-guard +
# lib/himi-ok.sh to this builder (config in /etc/modem-care.conf
# instead of UCI; diag access through our own diag_nv).
#
# Why: on the HiMI-baseband boards (UZ801 family and relatives) the
# modem RF task reads NV item 2500 (NV_FACTORY_DATA_4_I) and memcmp()s
# it against the literal "HiMI_OK".  When it does not match, the task
# takes a branch that ends in an ML1 fatal ~900 s after a modem
# (re)start.  Item 2500 is cleared at every modem boot, so it must be
# (re)written shortly after each one - hence a poll loop, not a
# one-shot.
#
# Safety: a write happens ONLY when the item reads back all-zero.
# Item 2500 is a generic factory-data item; on a non-HiMI modem it may
# hold real factory data, which is never clobbered.
#
# Default OFF (HIMI_OK_ENABLED=no in /etc/modem-care.conf); upstream
# runs it by default on its allow-listed boards - we leave the choice
# to the operator:  modem-care enable himi-ok
#
# Board gate: the DT compatible (from /proc/device-tree/compatible)
# must match one of the HIMI_OK_BOARDS globs.

CONF=/etc/modem-care.conf
HIMI_OK_ENABLED=no; HIMI_OK_INTERVAL=20
HIMI_OK_BOARDS="*uz801* *uf896* *ufi001c* *uf02* *hmuf02v5*"
[ -f "$CONF" ] && . "$CONF"

TAG=himi-ok-guard
NV=/usr/sbin/diag_nv
ITEM=2500
TOKEN=48694d495f4f4b    # "HiMI_OK"
DIAG_LOCK=/var/lock/himi-ok-diag.lock

log() { logger -t $TAG "$*"; }

[ "$HIMI_OK_ENABLED" = "yes" ] || { log "disabled by $CONF (HIMI_OK_ENABLED!=yes)"; exit 0; }
[ -x "$NV" ] || { log "ERROR: $NV not present/executable"; exit 1; }
case "$HIMI_OK_INTERVAL" in ''|*[!0-9]*) HIMI_OK_INTERVAL=20 ;; esac
[ "$HIMI_OK_INTERVAL" -ge 5 ] || HIMI_OK_INTERVAL=5

board_match() {
	local compat pat
	compat=$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null)
	[ -n "$compat" ] || return 1
	( set -f
	  for pat in $HIMI_OK_BOARDS; do
		case "$compat" in *$pat*) exit 0 ;; esac
	  done
	  exit 1 )
}
# HIMI_OK_BOARDS entries are plain substrings here (the upstream globs
# are all of the form *name*), so a substring match is equivalent.
board_match || { log "board not in HIMI_OK_BOARDS allow-list; exiting"; exit 0; }

payload_all_zero() {
	local hex
	hex=$(printf '%s\n' "$1" | sed -n 's/^[0-9a-f][0-9a-f]*  \(.*\) |.*/\1/p' | tr -d ' \n')
	[ -n "$hex" ] || return 1
	case "$hex" in *[!0]*) return 1 ;; esac
	return 0
}

warned_nonzero=
do_cycle() {
	local out w
	out=$("$NV" read "$ITEM" 2>/dev/null) || return 0
	printf '%s' "$out" | grep -q "HiMI_OK" && return 0
	printf '%s' "$out" | grep -q "status=0x0000" || return 0
	if ! payload_all_zero "$out"; then
		[ -n "$warned_nonzero" ] || {
			log "item $ITEM holds non-zero data (not HiMI_OK); leaving it untouched"
			warned_nonzero=1
		}
		return 0
	fi
	w=$("$NV" write "$ITEM" "$TOKEN" 2>/dev/null)
	if printf '%s' "$w" | grep -q "VERIFY: MATCH"; then
		log "item $ITEM was cleared; wrote HiMI_OK"
		warned_nonzero=
	else
		log "WARN: write did not verify"
	fi
}

log "start (item=$ITEM interval=${HIMI_OK_INTERVAL}s)"
mkdir -p /var/lock 2>/dev/null
exec 200>"$DIAG_LOCK"
while :; do
	if [ -c /dev/rpmsg0 ]; then
		flock -x 200
		do_cycle
		flock -u 200
	fi
	sleep "$HIMI_OK_INTERVAL"
done
