[Unit]
Description=MSM8916 USB Gadget configuration service
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount systemd-udevd.service
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/usb-gadget start
ExecStop=/usr/sbin/usb-gadget stop

[Install]
WantedBy=multi-user.target
